<!doctype html>
<html lang="{miu:locale /}">
<head>{include file="head" /}</head>
<body>
{include file="header" /}
<main id="main"><section class="page-intro"><div class="container">{miu:position /}<h1>{$tag.title}</h1></div></section><section class="section container">
    <!-- 标签页使用控制器已经按 tag_id 筛选的 list，不用文档列表标签重新查询。 -->
    <div class="document-grid">{volist name="list" id="vo"}{include file="card" /}{/volist}</div>
    {empty name="list"}<p class="empty-state">{miu:lang key='empty' /}</p>{/empty}
    {miu:pagelist theme='light' /}
</section></main>
{include file="footer" /}
</body>
</html>
