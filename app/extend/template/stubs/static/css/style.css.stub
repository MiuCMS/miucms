:root{--primary:#1768c5;--ink:#1d2939;--muted:#667085;--line:#e5e9ef;--surface:#f5f7fa;--width:1200px;--radius:8px;color-scheme:light}
*{box-sizing:border-box}body{margin:0;min-height:100vh;display:flex;flex-direction:column;color:var(--ink);background:#fff;font:15px/1.75 "PingFang SC","Microsoft YaHei","Hiragino Sans GB","Noto Sans CJK SC","Source Han Sans SC",system-ui,-apple-system,"Segoe UI",sans-serif}a{color:inherit;text-decoration:none}a:hover{color:var(--primary)}img{max-width:100%;height:auto;vertical-align:middle}button,input,textarea,select{font:inherit}button,a,input,textarea,select{-webkit-tap-highlight-color:transparent}button{cursor:pointer}a:focus-visible,button:focus-visible,input:focus-visible,textarea:focus-visible,select:focus-visible{outline:2px solid var(--primary);outline-offset:3px}h1,h2,h3,p{margin-top:0}h1{font-size:clamp(28px,3.5vw,44px);line-height:1.3;letter-spacing:-.03em}h2{font-size:24px;line-height:1.45}button,.button{display:inline-flex;align-items:center;justify-content:center;border:1px solid transparent;border-radius:5px;background:var(--primary);color:#fff;padding:9px 20px;line-height:1.5}.button:hover,button:hover{color:#fff;background:#11549e}input,textarea,select{max-width:100%;padding:10px 12px;border:1px solid #d0d5dd;border-radius:5px;background:#fff;color:var(--ink)}input[type=radio],input[type=checkbox]{width:auto;padding:0}.container{width:min(var(--width),calc(100% - 48px));margin-inline:auto}.section{padding-block:48px}.reading-layout{max-width:900px;margin-inline:auto}.reading-layout.container{width:min(900px,calc(100% - 48px))}.visually-hidden{position:absolute;width:1px;height:1px;padding:0;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}.skip-link{position:fixed;left:16px;top:-80px;z-index:40;padding:8px 16px;background:#fff}.skip-link:focus{top:12px}
/* ===== 头部：扁平化，纯色块 + 细边框 + 小圆角，不用渐变和重阴影 ===== */
.site-header{position:sticky;top:0;z-index:30;background:#fff;border-bottom:1px solid var(--line)}
.header-inner{display:flex;align-items:center;gap:22px;min-height:72px}
.brand{display:flex;align-items:center;gap:10px;flex:none;max-width:280px;font-size:21px;line-height:1.3;font-weight:750;letter-spacing:-.02em}
.brand:before{content:"";width:6px;height:20px;flex:none;border-radius:2px;background:var(--primary)}
.main-navigation{display:flex;align-items:center;gap:2px;flex:1;justify-content:flex-end;font-size:15px}
.main-navigation>a,.navigation-group>summary{display:inline-flex;align-items:center;padding:9px 14px;border-radius:6px;color:var(--ink)}
.main-navigation>a:hover,.navigation-group>summary:hover{background:var(--surface);color:var(--primary)}
.main-navigation .active{background:var(--surface);border-radius:6px;color:var(--primary);font-weight:600}summary{cursor:pointer;list-style:none}summary::-webkit-details-marker{display:none}.navigation-group,.language-switch{position:relative}/* 下拉箭头用 CSS 三角形：字符 ⌄ 贴基线会偏低，且各字体字形不一致；展开时翻转指向上方 */
.navigation-group>summary:after,.language-switch>summary:after{content:"";display:inline-block;width:0;height:0;margin-left:7px;vertical-align:middle;border:4px solid transparent;border-top-color:currentColor;transform-origin:50% 25%;transition:transform .2s}
.navigation-group[open]>summary:after,.language-switch[open]>summary:after{transform:rotate(180deg)}.navigation-children{position:absolute;top:100%;left:0;min-width:180px;z-index:20;padding:6px;margin-top:8px;background:#fff;border:1px solid var(--line);border-radius:8px;box-shadow:0 8px 24px #1d293914}
.navigation-children a{display:block;padding:8px 12px;border-radius:6px;white-space:nowrap}
.navigation-children a:hover{background:rgba(23,104,197,.1);color:var(--primary)}
/* 搜索框默认收起，点按钮展开：宽度与内边距一起过渡，收起时用 visibility 移出焦点顺序 */
.header-search{display:flex;align-items:center;margin-left:auto}
.header-search input{width:0;min-width:0;padding:0;border:1px solid transparent;border-radius:6px;background:var(--surface);opacity:0;visibility:hidden;transition:width .25s ease,padding .25s ease,opacity .2s ease,visibility 0s .25s}
.header-search.is-open input{width:200px;padding:8px 12px;border-color:var(--line);opacity:1;visibility:visible;margin-right:8px;transition:width .25s ease,padding .25s ease,opacity .2s ease,visibility 0s}
.header-search.is-open input:focus{border-color:var(--primary);background:#fff}
.header-search button{width:34px;height:34px;padding:0;border:1px solid var(--line);border-radius:6px;background:var(--surface);color:var(--ink)}
.header-search button:hover{border-color:var(--primary);color:var(--primary)}
.header-search.is-open button{width:auto;height:34px;padding:0 14px;border-color:var(--primary);background:var(--primary);color:#fff}
.header-tools{display:flex;align-items:center;gap:10px;white-space:nowrap;font-size:13px}
.language-switch>summary{padding:6px 10px;border:1px solid var(--line);border-radius:6px}
.language-switch>summary:hover{border-color:var(--primary);color:var(--primary)}
.language-switch .navigation-children{left:auto;right:0}
.header-tools .button{padding:6px 14px;border-radius:6px}
.menu-toggle{display:none}
.home-intro{padding:70px 0;background:var(--surface);border-bottom:1px solid var(--line)}.home-intro h1{max-width:900px;margin-bottom:20px}.home-intro p{max-width:700px;color:var(--muted);font-size:18px;margin:0}.page-intro{padding:30px 0;background:var(--surface);border-bottom:1px solid var(--line)}.page-intro h1{font-size:32px;margin:12px 0}.page-intro p{color:var(--muted);max-width:720px;margin:0}.section-heading{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:24px}.section-heading h2{margin:0}.section-heading>a,.text-link{font-weight:600;color:var(--primary)}.breadcrumb{display:flex;flex-wrap:wrap;gap:0;list-style:none;padding:0;margin:0 0 18px;font-size:13px;color:var(--muted)}.breadcrumb .text-white{color:var(--ink)}.delimiter{padding-inline:5px}.category-links{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:28px}.category-links a{padding:5px 15px;border:1px solid var(--line);border-radius:4px}.category-links a.active{border-color:var(--primary);color:var(--primary)}
/* 标签输出会留下空白文本节点，:empty 永不生效，改用 :has() 判断有没有内容 */
.category-links:not(:has(a)),.friend-links:not(:has(a)),.document-tags:not(:has(a)){display:none}
/* miu:list 的 emptykey 输出的是裸文本（grid 里的匿名项），整块没有卡片时按空状态排版 */
.document-grid:not(:has(.document-card)){padding:32px 0;color:var(--muted)}
.document-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px}.document-card{min-width:0;border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;background:#fff}.card-cover{display:flex;aspect-ratio:16/10;align-items:center;justify-content:center;overflow:hidden;background:#edf0f4;color:#98a2b3}.card-cover img{width:100%;height:100%;object-fit:cover;transition:transform .25s}.document-card:hover .card-cover img{transform:scale(1.025)}.card-content{padding:20px;display:flex;flex-direction:column}.card-content .text-link{margin-top:auto}.card-meta{display:flex;flex-wrap:wrap;gap:14px;color:var(--muted);font-size:13px}.document-card h2{margin:10px 0;font-size:20px;line-height:1.5}.document-card h2 a{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.document-card p{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;color:var(--muted);font-size:14px;margin-bottom:14px}.document-grid--rows{grid-template-columns:1fr;gap:0}.document-grid--rows .document-card{display:grid;grid-template-columns:200px minmax(0,1fr);gap:24px;border:0;border-bottom:1px solid var(--line);border-radius:0;padding:24px 0}.document-grid--rows .document-card:last-child{border-bottom:0}.document-grid--rows .card-cover{height:140px;aspect-ratio:auto;border-radius:6px}.document-grid--rows .card-content{padding:0}.document-grid--rows .document-card h2{margin-top:6px}.empty-state{padding:32px 0;color:var(--muted);grid-column:1/-1}.document-heading{margin:20px 0 32px}.document-heading h1{margin-bottom:12px}.document-heading>p{font-size:18px;color:var(--muted)}.document-cover{display:block;width:100%;max-height:580px;object-fit:contain;margin:0 auto 32px;background:var(--surface);border-radius:6px}.document-body{margin:30px 0;font-size:16px;line-height:1.95;overflow-wrap:anywhere}.document-body h2,.document-body h3{margin-top:1.6em}.document-body pre{padding:18px;background:var(--surface);overflow:auto;border-radius:6px;font-size:14px}.document-body blockquote{margin:24px 0;padding:12px 20px;background:var(--surface);border-left:3px solid var(--primary)}.document-body table{display:block;overflow-x:auto;border-collapse:collapse}.document-body td,.document-body th{padding:10px 14px;border:1px solid var(--line)}.document-body iframe,.document-body video{max-width:100%}.document-tags{display:flex;flex-wrap:wrap;gap:8px;margin:28px 0}.document-tags a{padding:3px 12px;border:1px solid var(--line);border-radius:4px;font-size:13px}.document-adjacent{display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-top:36px;border-top:1px solid var(--line);padding-top:24px}.document-adjacent a{color:var(--muted);min-width:0}.document-adjacent strong{display:block;color:var(--ink);font-size:15px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.document-adjacent a:last-child{text-align:right}.document-adjacent .disabled{opacity:.45;pointer-events:none}
.gallery{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px;margin:28px 0}.gallery figure{margin:0;min-width:0}.gallery img{width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:6px;background:var(--surface)}.gallery figcaption{padding-top:8px;color:var(--muted);font-size:14px}.product-summary{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center;margin:28px 0 50px}.product-cover,.image-placeholder{width:100%;aspect-ratio:4/3;object-fit:contain;background:var(--surface);border-radius:8px}.image-placeholder{display:flex;align-items:center;justify-content:center;color:var(--muted)}.product-summary p{color:var(--muted)}.product-summary .product-price{font-size:25px;color:var(--primary);margin-top:28px}.parameter-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));margin:24px 0;border-top:1px solid var(--line)}.parameter-list>div{display:grid;grid-template-columns:110px minmax(0,1fr);gap:12px;border-bottom:1px solid var(--line);padding:12px 0}.parameter-list dt{color:var(--muted)}.parameter-list dd{margin:0;overflow-wrap:anywhere}.software-summary{display:flex;align-items:flex-start;gap:28px}.software-summary>img{width:100px;height:100px;object-fit:contain;border-radius:8px}.software-summary .parameter-list{flex:1;margin-top:0}.download-resources{margin-top:40px}.download-row{display:flex;justify-content:space-between;align-items:center;gap:20px;padding:22px 0;border-top:1px solid var(--line)}.download-row strong,.download-row span,.download-row small{display:block}.download-row span,.download-row small{color:var(--muted);font-size:13px}.topic-section{padding:24px 0;border-top:1px solid var(--line)}.topic-link{display:flex;justify-content:space-between;gap:20px;padding:12px 0;border-bottom:1px solid var(--line)}
.video-layout{display:grid;grid-template-columns:minmax(0,1fr) 290px;gap:24px;align-items:stretch}.player-stage{background:#111;aspect-ratio:16/9;position:relative;min-width:0}.player-stage video,#starter-dplayer{width:100%;height:100%;position:absolute;inset:0}.player-error{position:absolute;bottom:0;left:0;right:0;margin:0;padding:14px 18px;color:#fff;background:#000c}.episode-section{min-height:0;max-height:100%;overflow:auto;background:var(--surface);border:1px solid var(--line);padding:20px}.episode-section h2{font-size:19px;margin-bottom:14px}.episode-section select{width:100%;margin-bottom:12px}.episode-group p{font-size:13px;color:var(--muted)}.episode-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.episode-list button{min-width:0;background:#fff;color:var(--ink);border-color:var(--line);padding:7px 8px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.episode-list button.active{color:var(--primary);border-color:var(--primary)}[hidden]{display:none!important}
.message-form{padding-top:24px;border-top:1px solid var(--line)}.message-field{margin-bottom:20px}.message-field>label{display:block;margin-bottom:6px;font-weight:600}.message-field>label>span{color:#d92d20}.message-field>input,.message-field>select,.message-field>textarea{width:100%}.choice-options{display:flex;flex-wrap:wrap;gap:20px}.choice-options label{font-weight:400}.site-footer{padding:34px 0;margin-top:auto;background:var(--surface);border-top:1px solid var(--line);font-size:13px;color:var(--muted)}.friend-links{display:flex;flex-wrap:wrap;gap:18px;margin-bottom:20px}.footer-bottom{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap}.footer-bottom p{margin:0}.miu-pagination{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin-top:32px;padding:0;list-style:none}.site-footer a:hover{color:var(--primary)}
@media(max-width:1080px){.header-inner{gap:16px;flex-wrap:wrap;padding-block:14px;min-height:0}.main-navigation{order:5;flex-basis:100%;justify-content:flex-start;flex-wrap:wrap;gap:2px;padding-top:8px;border-top:1px solid var(--line)}.header-search{margin-left:auto}.header-search.is-open input{width:180px}.document-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.document-grid--rows{grid-template-columns:1fr}.video-layout{grid-template-columns:minmax(0,1fr) 240px}.episode-section{padding:14px}}
@media(max-width:680px){.container,.reading-layout.container{width:calc(100% - 32px)}.section{padding-block:30px}.brand{font-size:19px;max-width:65%}.menu-toggle{display:inline-flex;margin-left:auto;padding:7px 12px;background:#fff;color:var(--ink);border-color:var(--line)}.header-inner{gap:12px;min-height:0;padding-block:12px}.header-search{order:2;flex:0 0 auto;margin-left:0}.header-search.is-open{flex:1 1 100%}.header-search.is-open input{flex:1;width:auto}.header-tools{order:3;margin-left:0;gap:10px;font-size:13px}.main-navigation{display:none;flex-direction:column;align-items:stretch;gap:0;order:4;justify-content:flex-start}.main-navigation.is-open{display:flex}.main-navigation>a,.navigation-group>summary{padding:11px 12px;border-radius:0;border-top:1px solid var(--line)}.navigation-group .navigation-children{position:static;margin:0 0 8px;box-shadow:none;border:0;background:var(--surface)}.language-switch>summary{border:0;background:var(--surface)}.home-intro{padding:42px 0}.home-intro p{font-size:16px}.page-intro{padding:20px 0}.page-intro h1{font-size:27px}.document-grid{grid-template-columns:1fr;gap:20px}.document-grid--rows .document-card{grid-template-columns:100px minmax(0,1fr);gap:15px;padding:20px 0}.document-grid--rows .card-cover{height:90px}.document-card h2{font-size:18px}.document-grid--rows .document-card p{-webkit-line-clamp:1}.card-content{padding:17px}.document-grid--rows .card-meta{font-size:11px;gap:8px}.document-grid--rows .text-link{font-size:13px}.gallery{gap:14px}.product-summary{grid-template-columns:1fr;gap:24px;margin-bottom:30px}.parameter-list{grid-template-columns:1fr}.software-summary{gap:16px;flex-direction:column}.software-summary .parameter-list{width:100%}.software-summary>img{width:80px;height:80px}.document-adjacent{grid-template-columns:1fr;gap:16px}.document-adjacent a:last-child{text-align:left}.video-layout{grid-template-columns:1fr}.episode-section{max-height:340px}.episode-list{grid-template-columns:repeat(3,minmax(0,1fr))}.download-row{gap:12px}.download-row .button{padding:8px 12px;white-space:nowrap}.document-body{font-size:15px}.footer-bottom{flex-direction:column;gap:10px}}
/* 分集侧栏以播放器区域为高度基准，长列表在内部滚动，不撑高播放器。 */
@media(min-width:681px){.video-layout{display:block;position:relative;padding-right:314px}.episode-section{position:absolute;top:0;right:0;bottom:0;width:290px;max-height:none}}
@media(min-width:681px) and (max-width:1080px){.video-layout{padding-right:264px}.episode-section{width:240px}}
@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;transition:none!important}}
