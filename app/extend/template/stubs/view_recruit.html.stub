<!doctype html>
<html lang="{miu:locale /}">
<head>{include file="head" /}</head>
<body>
{include file="header" /}
<main id="main" class="section container reading-layout">
    {miu:position /}
    <header class="document-heading"><h1>{$doc.title}</h1><p>{$doc.title_ext_1|default=''}</p></header>
    <dl class="parameter-list"><div><dt>{miu:lang key='location' /}</dt><dd>{$doc.word_location|default=''}</dd></div><div><dt>{miu:lang key='education' /}</dt><dd>{$doc.educational|default=''}</dd></div><div><dt>{miu:lang key='salary' /}</dt><dd>{$doc.salary|default=''}</dd></div><div><dt>{miu:lang key='experience' /}</dt><dd>{$doc.working_years|default=''}</dd></div><div><dt>{miu:lang key='vacancies' /}</dt><dd>{$doc.recruit_num|default=''}</dd></div></dl>
    {include file="document_body" /}
    {include file="detail_end" /}
</main>
{include file="footer" /}
</body>
</html>
