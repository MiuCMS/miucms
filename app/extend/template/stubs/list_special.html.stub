<!doctype html>
<html lang="{miu:locale /}">
<head>{include file="head" /}</head>
<body>
{include file="header" /}
<main id="main">
    <section class="page-intro"><div class="container">{miu:position /}<h1>{$nav.title}</h1><p>{$nav.seo_description|default=''}</p></div></section>
    <section class="section container">
        <nav class="category-links">{miu:nav id='vo' pid='$nav.top_navid'}<a href="{$vo.url}" class="{$vo.currentstyle}">{$vo.title}</a>{/miu:nav}</nav>
        <div class="document-grid document-grid--rows">{miu:list id='vo' pagesize='12' emptykey='empty'}
            <article class="document-card"><a class="card-cover" href="{$vo.url}">{notempty name="vo.litpic"}<img src="{$vo.litpic}" alt="{$vo.title}" loading="lazy">{else/}<span>{miu:lang key='noImage' /}</span>{/notempty}</a><div class="card-content"><div class="card-meta"><span>{$vo.nav_name}</span><time>{$vo.date}</time></div><h2><a href="{$vo.url}">{$vo.title}</a></h2><p>{$vo.title_ext_1|default=''}</p><a class="text-link" href="{$vo.url}">{miu:lang key='more' /} <span aria-hidden="true">→</span></a></div></article>
        {/miu:list}</div>
        {miu:pagelist theme='light' /}
    </section>
</main>
{include file="footer" /}
</body>
</html>
