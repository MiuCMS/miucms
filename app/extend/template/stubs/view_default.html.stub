<!doctype html>
<html lang="{miu:locale /}">
<head>{include file="head" /}</head>
<body>
{include file="header" /}
<main id="main" class="section container reading-layout">
    {miu:position /}
    <article><header class="document-heading"><h1>{$doc.title}</h1><p>{$doc.title_ext_1|default=''}</p><div class="card-meta"><time>{$doc.date}</time><span>{$doc.author|default=''}</span><a href="{$doc.nav_url}">{$doc.nav_name}</a></div></header>
        {notempty name="doc.litpic"}<img class="document-cover" src="{$doc.litpic}" alt="{$doc.title}">{/notempty}
        {include file="document_body" /}
    </article>
    {include file="detail_end" /}
</main>
{include file="footer" /}
</body>
</html>
