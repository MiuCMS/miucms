<footer class="site-footer"><div class="container">
    <div class="friend-links">{miu:link id='vo'}<a href="{$vo.url}"{if condition="$vo.target_blank eq 1"} target="_blank" rel="noopener noreferrer"{/if}>{$vo.name}</a>{/miu:link}</div>
    <div class="footer-bottom"><div>{miu:global name='site_copyright' raw='1' /}</div><span>Power by <a href="{:config('official.website')}" target="_blank" rel="noopener noreferrer">MiuCMS</a></span></div>
    {miu:global name='site_icp' /}
</div></footer>
<div id="template-i18n" hidden data-user-location-failed="{miu:lang key='user_js.location_failed' /}" data-user-country-placeholder="{miu:lang key='user_js.country_placeholder' /}" data-user-province-placeholder="{miu:lang key='user_js.province_placeholder' /}" data-user-city-placeholder="{miu:lang key='user_js.city_placeholder' /}" data-user-avatar-too-large="{miu:lang key='user_js.avatar_too_large' /}" data-user-avatar-not-square="{miu:lang key='user_js.avatar_not_square' /}" data-user-avatar-invalid="{miu:lang key='user_js.avatar_invalid' /}" data-user-avatar-uploading="{miu:lang key='user_js.avatar_uploading' /}" data-user-avatar-upload-failed="{miu:lang key='user_js.avatar_upload_failed' /}" data-user-avatar-alt="{miu:lang key='user_js.avatar_alt' /}" data-user-avatar-uploaded="{miu:lang key='user_js.avatar_uploaded' /}" data-user-email-captcha-required="{miu:lang key='user_js.email_captcha_required' /}" data-user-sending-code="{miu:lang key='user_js.sending_code' /}" data-user-code-sent="{miu:lang key='user_js.code_sent' /}" data-user-code-failed="{miu:lang key='user_js.code_failed' /}" data-user-network-failed="{miu:lang key='user_js.network_failed' /}" data-user-submitting="{miu:lang key='user_js.submitting' /}" data-user-operation-success="{miu:lang key='user_js.operation_success' /}" data-user-submit-failed="{miu:lang key='user_js.submit_failed' /}" data-user-logout-confirm="{miu:lang key='user_js.logout_confirm' /}" data-user-logout-failed="{miu:lang key='user_js.logout_failed' /}" data-user-invite-copied="{miu:lang key='user_js.invite_copied' /}" data-user-copy-failed="{miu:lang key='user_js.copy_failed' /}"></div>
<script src="{__JS__}/app.js" defer></script>
