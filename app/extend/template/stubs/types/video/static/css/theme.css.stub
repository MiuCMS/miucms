/* 视频站：把不同播放内容排成独立章节，标题、海报和播放器都使用真实文档数据。 */
:root{--primary:#db6d3d;--ink:#f4f0e8;--muted:#a4aaa5;--line:#39413e;--surface:#202725;--width:1240px;--radius:2px;color-scheme:dark}
body.theme-video{background:#151b19;color:#f4f0e8}
.theme-video .site-header{background:#151b19;border-bottom:1px solid #39413e}
.theme-video .main-navigation>a,.theme-video .navigation-group>summary{color:#f4f0e8}
.theme-video .main-navigation>a:hover,.theme-video .navigation-group>summary:hover{background:#252e2a;color:#f4b08d}
.theme-video .main-navigation .active{background:#252e2a;color:#f4b08d}
.theme-video .header-search input{background:#202725;color:#f4f0e8}
.theme-video .header-search button,.theme-video .menu-toggle{background:#202725;color:#f4f0e8;border-color:#39413e}
.theme-video .header-tools .button{background:#db6d3d;color:#161b19}
.theme-video .navigation-children{background:#202725;border-color:#39413e}
.theme-video .navigation-children a:hover{background:#303a35;color:#f4b08d}
.video-masthead{padding:clamp(54px,9vw,116px) 0 62px;background:#252e2a;border-bottom:8px solid #db6d3d}
.video-kicker{margin:0 0 14px;color:#f4b08d;font-size:12px;font-weight:700;letter-spacing:.17em;text-transform:uppercase}
.video-masthead h1{max-width:980px;margin:0 0 18px;font-size:clamp(44px,8vw,104px);font-weight:650;line-height:1;letter-spacing:-.055em}
.video-masthead .container>p:not(.video-kicker){max-width:660px;color:#c0c5c0;font-size:18px}
.video-browse-link{display:inline-flex;gap:14px;align-items:center;margin-top:20px;padding:9px 0;border-bottom:1px solid #f4b08d;color:#f4b08d;font-weight:700}
.video-shelf,.video-list-section{padding-block:52px 76px}
.video-shelf-heading{display:flex;justify-content:space-between;align-items:baseline;gap:20px;margin-bottom:26px;padding-bottom:14px;border-bottom:4px solid #f4f0e8}
.video-shelf-heading h2{margin:0;font-size:27px}
.video-shelf-heading>span{max-width:420px;color:#a4aaa5;font-size:13px}
.video-chapters{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:30px 24px}
.video-chapter{min-width:0;background:#202725}
.video-chapter:nth-child(4n+1){background:#303a35}
.video-chapter:nth-child(4n+2){background:#34302b}
.video-chapter-poster{position:relative;display:flex;aspect-ratio:16/9;align-items:center;justify-content:center;overflow:hidden;background:#303a35;color:#a4aaa5}
.video-chapter-poster img{width:100%;height:100%;object-fit:cover;transition:transform .45s ease}
.video-chapter:hover .video-chapter-poster img{transform:scale(1.035)}
.video-chapter-poster i{position:absolute;left:18px;bottom:16px;display:grid;width:46px;height:46px;place-items:center;border:1px solid #ffffffa3;border-radius:50%;background:#151b19c9;color:#fff;font-size:15px;font-style:normal}
.video-chapter>div{padding:20px 22px 22px;border-bottom:4px solid #db6d3d}
.video-chapter>div>span{color:#f4b08d;font-size:12px}
.video-chapter h2,.video-chapter h3{margin:8px 0;font-size:22px;line-height:1.35}
.video-chapter h2 a,.video-chapter h3 a{color:#f4f0e8}
.video-chapter p{margin:0;color:#a4aaa5;font-size:14px}
.video-list-intro{padding-block:40px;background:#252e2a;border-bottom:5px solid #db6d3d}
.video-list-intro h1{font-size:clamp(36px,6vw,70px)}
.video-detail-page{padding-block:26px 70px}
.video-detail-heading{padding-block:24px 30px}
.video-detail-heading h1{font-size:clamp(34px,6vw,66px)}
.video-detail-heading>p:not(.video-kicker){color:#a4aaa5;font-size:18px}
.theme-video .video-layout{margin-bottom:40px}
.theme-video .player-stage{background:#090d0b}
.theme-video .episode-section{background:#202725;border-color:#39413e}
.theme-video .episode-list button{background:#151b19;color:#f4f0e8;border-color:#39413e}
.theme-video .episode-list button.active{border-color:#db6d3d;color:#f4b08d}
.theme-video .episode-section select{background:#151b19;color:#f4f0e8;border-color:#39413e}
.theme-video .document-card{background:#202725;border-color:#39413e}
.theme-video .document-card h2 a{color:#f4f0e8}
.theme-video .document-card p,.theme-video .card-meta{color:#a4aaa5}
.theme-video .page-intro{background:#202725;border-color:#39413e}
.video-detail-copy{margin:30px 0;color:#e4e5e1}
.theme-video .site-footer{background:#202725;border-color:#39413e;color:#a4aaa5}
.theme-video .site-footer a{color:#e4e5e1}
@media(max-width:680px){.video-masthead{padding-block:54px 44px}.video-masthead .container>p:not(.video-kicker){font-size:16px}.video-shelf-heading{align-items:flex-start;flex-direction:column;gap:7px}.video-chapters{grid-template-columns:1fr;gap:20px}.video-chapter>div{padding:16px}.video-chapter h2,.video-chapter h3{font-size:19px}.video-detail-heading{padding-block:18px 22px}}
