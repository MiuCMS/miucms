/* 博客：以纸本文集的标题层级和时间轴呈现真实文章，不依赖虚构配图。 */
:root{--primary:#9a4b34;--ink:#272421;--muted:#756d65;--line:#d9d0c5;--surface:#eee9e1;--width:1120px;--radius:2px}
body.theme-blog{background:#f5f1e9;color:#272421;font-size:16px}
.theme-blog .site-header{background:#f5f1e9;border-bottom:2px solid #272421}
.theme-blog .brand:before{background:#9a4b34}
.blog-masthead{padding:clamp(64px,12vw,150px) 0 58px;background:#e9e2d7;border-bottom:7px solid #272421}
.blog-masthead .container{position:relative}
.blog-kicker{margin:0 0 18px;color:#9a4b34;font-size:12px;font-weight:700;letter-spacing:.16em;text-transform:uppercase}
.blog-masthead h1{max-width:100%;margin:0 0 18px;font-family:Georgia,"Songti SC",serif;font-size:clamp(48px,10vw,132px);font-weight:500;line-height:.98;letter-spacing:-.055em;overflow-wrap:anywhere}
.blog-masthead .container>p:not(.blog-kicker){max-width:590px;margin:0;color:#625b54;font-size:18px}
.blog-search-link{display:inline-flex;gap:14px;align-items:center;margin-top:30px;padding:8px 0;border-bottom:1px solid #9a4b34;color:#9a4b34;font-weight:700}
.blog-stream{padding-block:54px 80px}
.blog-stream-heading{display:flex;align-items:baseline;justify-content:space-between;gap:20px;padding-bottom:18px;border-bottom:4px solid #272421}
.blog-stream-heading h2{margin:0;font-family:Georgia,"Songti SC",serif;font-size:clamp(26px,4vw,42px);font-weight:500}
.blog-stream-heading>span{color:#756d65;font-size:13px}
.blog-entry-list{list-style:none;padding:0;margin:0}
.blog-entry{display:grid;grid-template-columns:120px minmax(0,1fr) 140px;gap:24px;align-items:baseline;padding:21px 0;border-bottom:1px solid #c9c0b5}
.blog-entry time,.blog-entry-channel{color:#756d65;font-size:13px;font-variant-numeric:tabular-nums}
.blog-entry-title{font-family:Georgia,"Songti SC",serif;font-size:clamp(19px,2.2vw,26px);line-height:1.4}
.blog-entry-title:hover{color:#9a4b34}
.blog-entry-channel{text-align:right}
.blog-list-intro{padding-block:50px;background:#e9e2d7;border-bottom:4px solid #272421}
.blog-list-intro h1{font-family:Georgia,"Songti SC",serif;font-size:clamp(38px,7vw,76px);font-weight:500}
.blog-archive{padding-block:20px 64px}
.blog-archive-entry{display:grid;grid-template-columns:115px minmax(0,1fr) minmax(130px,240px);gap:28px;align-items:center;padding:28px 0;border-bottom:1px solid #c9c0b5}
.blog-archive-entry>time{align-self:start;padding-top:7px;color:#756d65;font-size:13px}
.blog-archive-entry h2{margin:7px 0;font-family:Georgia,"Songti SC",serif;font-size:25px;font-weight:500}
.blog-archive-entry p{margin:0;color:#756d65;font-size:14px}
.blog-archive-image img{width:100%;aspect-ratio:4/3;object-fit:cover}
.blog-article-heading{padding:20px 0 32px;border-bottom:4px solid #272421}
.blog-article-heading h1{font-family:Georgia,"Songti SC",serif;font-size:clamp(34px,6vw,66px);font-weight:500}
.blog-article-heading>p:not(.blog-kicker){max-width:720px;color:#625b54;font-size:19px}
.theme-blog .document-body{font-family:Georgia,"Songti SC",serif;font-size:18px;line-height:2.05}
@media(max-width:680px){.blog-masthead{padding-block:58px 38px}.blog-masthead .container>p:not(.blog-kicker){font-size:16px}.blog-entry{grid-template-columns:78px minmax(0,1fr);gap:12px;padding:17px 0}.blog-entry-channel{display:none}.blog-archive-entry{grid-template-columns:1fr 92px;gap:14px}.blog-archive-entry>time{grid-column:1/-1;padding:0}.blog-archive-entry h2{font-size:19px}.blog-archive-entry p{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.blog-archive-image img{aspect-ratio:1}.theme-blog .document-body{font-size:16px}}
