/* 资讯门户：用报刊目录的标题层级和栏目分栏组织真实资讯。 */
:root{--primary:#9c3e38;--ink:#261f22;--muted:#746b6b;--line:#d9cfd0;--surface:#eee8e8;--width:1220px;--radius:0}
body.theme-portal{background:#f6f2f1;color:#261f22}
.theme-portal .site-header{background:#f6f2f1;border-bottom:4px solid #261f22}
.theme-portal .brand:before{background:#9c3e38}
.portal-masthead{padding:42px 0 36px;background:#eee8e8}
.portal-kicker{margin:0 0 11px;color:#9c3e38;font-size:12px;font-weight:750;letter-spacing:.15em;text-transform:uppercase}
.portal-masthead h1{margin:0 0 12px;font-family:Georgia,"Songti SC",serif;font-size:clamp(40px,7vw,78px);font-weight:500;line-height:1.05;letter-spacing:-.045em}
.portal-masthead p:not(.portal-kicker){max-width:720px;margin:0;color:#746b6b;font-size:17px}
.portal-front{padding-block:38px 48px}
.portal-section-heading{display:flex;align-items:baseline;justify-content:space-between;gap:18px;margin-bottom:20px;padding-bottom:11px;border-bottom:4px solid #261f22}
.portal-section-heading h2{margin:0;font-family:Georgia,"Songti SC",serif;font-size:27px;font-weight:600}
.portal-section-heading>a,.portal-channel-link{color:#9c3e38;font-size:13px;font-weight:700}
.portal-top-grid{display:grid;grid-template-columns:1.35fr 1fr 1fr;gap:18px}
.portal-top-story{min-width:0;background:#eee8e8}
.portal-top-story:first-child{grid-row:span 2}
.portal-story-image{display:flex;aspect-ratio:16/10;align-items:center;justify-content:center;background:#ded5d5;color:#746b6b}
.portal-top-story:first-child .portal-story-image{aspect-ratio:4/3}
.portal-story-image img{width:100%;height:100%;object-fit:cover}
.portal-top-story>div{padding:14px 16px 16px;border-bottom:3px solid #9c3e38}
.portal-top-story>div>span,.portal-article-list article>div>span{color:#9c3e38;font-size:12px;font-weight:650}
.portal-top-story h3{margin:6px 0;font-family:Georgia,"Songti SC",serif;font-size:19px;line-height:1.4}
.portal-top-story h3 a{color:#261f22}
.portal-top-story p{margin:0;color:#746b6b;font-size:13px}
.portal-channels{padding-block:38px 70px;background:#eee8e8}
.portal-channel{display:grid;grid-template-columns:minmax(180px,28%) 1fr;gap:28px;padding:26px 0;border-top:2px solid #b7a8a9}
.portal-channel header{display:flex;flex-direction:column;align-items:flex-start;gap:14px}
.portal-channel header h3{margin:0;font-family:Georgia,"Songti SC",serif;font-size:clamp(23px,3vw,34px);line-height:1.2}
.portal-channel header h3 a{color:#261f22}
.portal-channel ol{list-style:none;margin:0;padding:0}
.portal-channel li{display:grid;grid-template-columns:100px minmax(0,1fr);gap:16px;padding:8px 0}
.portal-channel li time{color:#746b6b;font-size:12px;font-variant-numeric:tabular-nums}
.portal-channel li a{font-size:15px}
.portal-list-intro{padding-block:38px;background:#eee8e8;border-bottom:4px solid #261f22}
.portal-list-intro h1{font-family:Georgia,"Songti SC",serif;font-size:clamp(36px,6vw,68px);font-weight:500}
.portal-list-section{padding-block:28px 64px}
.portal-article-list article{display:grid;grid-template-columns:100px minmax(0,1fr) 180px;gap:22px;align-items:center;padding:22px 0;border-bottom:1px solid #d9cfd0}
.portal-article-list article>time{align-self:start;padding-top:6px;color:#746b6b;font-size:12px}
.portal-article-list h2{margin:5px 0;font-family:Georgia,"Songti SC",serif;font-size:22px;line-height:1.35}
.portal-article-list p{margin:0;color:#746b6b;font-size:13px}
.portal-list-image img{width:100%;aspect-ratio:4/3;object-fit:cover}
.portal-article-heading{padding:15px 0 28px;border-bottom:4px solid #261f22}
.portal-article-heading h1{font-family:Georgia,"Songti SC",serif;font-size:clamp(34px,6vw,64px);font-weight:500}
.portal-article-heading>p:not(.portal-kicker){max-width:760px;color:#746b6b;font-size:18px}
.theme-portal .document-body{font-size:17px;line-height:1.95}
@media(max-width:760px){.portal-masthead{padding-block:34px 28px}.portal-top-grid{grid-template-columns:1fr 1fr;gap:12px}.portal-top-story:first-child{grid-column:1/-1;grid-row:auto}.portal-top-story:first-child .portal-story-image{aspect-ratio:16/9}.portal-top-story>div{padding:11px}.portal-top-story h3{font-size:16px}.portal-top-story p{display:none}.portal-channel{grid-template-columns:1fr;gap:10px}.portal-channel header{flex-direction:row;align-items:baseline;justify-content:space-between}.portal-channel li{grid-template-columns:78px 1fr;gap:10px}.portal-channel li a{font-size:14px}.portal-article-list article{grid-template-columns:1fr 88px;gap:12px}.portal-article-list article>time{grid-column:1/-1;padding:0}.portal-article-list h2{font-size:18px}.portal-article-list p{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.portal-list-image img{aspect-ratio:1}}
