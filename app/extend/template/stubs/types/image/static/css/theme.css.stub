/* 图片站：以真实上传图像组成不等高的画廊墙，标题和留白保持安静。 */
:root{--primary:#456553;--ink:#17231d;--muted:#68756d;--line:#cdd4cd;--surface:#e8ece6;--width:1320px;--radius:0}
body.theme-image{background:#f0f2ed;color:#17231d}
.theme-image .site-header{background:#f0f2ed;border-bottom:1px solid #cdd4cd}
.theme-image .brand:before{background:#456553}
.image-masthead{padding:clamp(48px,8vw,100px) 0 22px}
.image-masthead .container{display:grid;grid-template-columns:1fr minmax(260px,36%);column-gap:8%;align-items:end}
.image-kicker{grid-column:1/-1;margin:0 0 12px;color:#456553;font-size:12px;font-weight:700;letter-spacing:.16em;text-transform:uppercase}
.image-masthead h1{grid-column:1;margin:0;font-size:clamp(44px,8vw,100px);font-weight:500;line-height:1.02;letter-spacing:-.06em}
.image-masthead .container>p:not(.image-kicker){grid-column:2;grid-row:2;margin:0 0 10px;color:#68756d;font-size:17px}
.image-home-section,.image-list-section{padding-block:36px 72px}
.gallery-wall{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));grid-auto-rows:42px;gap:14px;align-items:stretch}
.gallery-tile{position:relative;grid-column:span 4;grid-row:span 6;min-width:0;overflow:hidden;background:#dce3da}
.gallery-tile:nth-child(5n+1){grid-column:span 7;grid-row:span 9}
.gallery-tile:nth-child(5n+2){grid-column:span 5;grid-row:span 6}
.gallery-tile:nth-child(5n+3){grid-column:span 4;grid-row:span 7}
.gallery-tile:nth-child(5n+4){grid-column:span 4;grid-row:span 5}
.gallery-tile:nth-child(5n){grid-column:span 4;grid-row:span 8}
.gallery-tile-image{display:flex;width:100%;height:100%;align-items:center;justify-content:center;color:#68756d;background:#dce3da}
.gallery-tile-image img{width:100%;height:100%;object-fit:cover;transition:transform .45s ease}
.gallery-tile:hover .gallery-tile-image img{transform:scale(1.035)}
.gallery-tile-caption{position:absolute;right:0;bottom:0;left:0;padding:14px 18px 15px;color:#fff;background:#17231de8}
.gallery-tile-caption>span,.gallery-tile-caption p{margin:0;color:#e3e8e2;font-size:12px}
.gallery-tile-caption h2{margin:4px 0 0;font-size:19px;line-height:1.35}
.gallery-tile-caption h2 a{color:inherit}
.image-list-intro{padding-block:38px;background:#e2e8e0;border-bottom:0}
.image-list-intro h1{font-size:clamp(36px,6vw,68px);font-weight:500}
.image-list-intro p:not(.image-kicker){color:#68756d}
.image-detail{padding-block:28px 72px}
.image-detail-heading{max-width:850px;margin:26px auto 36px;text-align:center}
.image-detail-heading h1{font-size:clamp(34px,6vw,68px);font-weight:500}
.image-detail-heading>p{color:#68756d;font-size:18px}
.image-detail-heading time{color:#68756d;font-size:13px}
.theme-image .gallery{grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}
.theme-image .gallery img{border-radius:0;background:#dce3da}
.image-detail-copy{margin-top:48px}
@media(max-width:760px){.image-masthead .container{grid-template-columns:1fr;gap:12px}.image-kicker{grid-column:1}.image-masthead h1{grid-column:1;grid-row:auto}.image-masthead .container>p:not(.image-kicker){grid-column:1;grid-row:auto;margin:0}.gallery-wall{grid-template-columns:repeat(6,minmax(0,1fr));grid-auto-rows:34px;gap:9px}.gallery-tile,.gallery-tile:nth-child(n){grid-column:span 3;grid-row:span 6}.gallery-tile:nth-child(3n+1){grid-column:span 6;grid-row:span 8}.gallery-tile-caption{padding:36px 12px 10px}.gallery-tile-caption h2{font-size:16px}.theme-image .gallery{grid-template-columns:1fr}.image-detail-heading{margin-block:22px}}
