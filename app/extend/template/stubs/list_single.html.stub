<!doctype html>
<html lang="{miu:locale /}">
<head>{include file="head" /}</head>
<body>
{include file="header" /}
<!-- 单页模型使用栏目地址，doc 是栏目与附加内容的合并数据，没有文档列表分页。 -->
<main id="main" class="section container reading-layout">{miu:position /}<header class="document-heading"><h1>{$nav.title}</h1><p>{$nav.seo_description|default=''}</p></header><article>{include file="document_body" /}</article></main>
{include file="footer" /}
</body>
</html>
